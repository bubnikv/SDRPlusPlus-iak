canvas {
  width = 1024
  height = 1024
}

forall EMWave w {
  -- The construction is a 2-D projection of a true 3-D transverse EM wave.
  -- 3-D basis: k = x, E = y, H = z, so E ⟂ H ⟂ k.
  -- Projection used for H: P(x,y,z) = (x -0.62 z, y -0.38 z).
  w.bg = Rectangle {
    center: (0, 0)
    width: 920
    height: 920
    cornerRadius: 190
    fillColor: rgba(0.018, 0.047, 0.095, 1.0)
    strokeColor: rgba(0.10, 0.32, 0.52, 0.85)
    strokeWidth: 5
  }

  w.kAxis = Line {
    start: (-390, 0)
    end: (390, 0)
    strokeColor: rgba(0.82, 0.90, 0.98, 0.58)
    strokeWidth: 5
    strokeLinecap: "round"
  }
  w.kArrow = Polygon {
    points: [[390, 0], [352, 19], [352, -19]]
    fillColor: rgba(0.82, 0.90, 0.98, 0.78)
  }

  -- E axis is vertical in the projected image.
  w.eAxis = Line {
    start: (-340.0, -185)
    end: (-340.0, 185)
    strokeColor: rgba(0.18, 0.83, 1.0, 0.48)
    strokeWidth: 4
    strokeLinecap: "round"
  }
  w.eArrow = Polygon {
    points: [[-340.0, 185], [-356.0, 150], [-324.0, 150]]
    fillColor: rgba(0.18, 0.83, 1.0, 0.75)
  }

  -- H axis is the projected z axis; it is perpendicular to E in 3-D.
  w.hAxis = Line {
    start: (-243.900, 58.900)
    end: (-436.100, -58.900)
    strokeColor: rgba(0.33, 0.96, 0.58, 0.48)
    strokeWidth: 4
    strokeLinecap: "round"
  }
  w.hArrow = Polygon {
    points: [[-436.100, -58.900], [-433.600, -41.400], [-407.600, -57.400]]
    fillColor: rgba(0.33, 0.96, 0.58, 0.75)
  }

  -- One complete field cycle spans the full propagation axis.
  w.eWaveGlow = Path {
    d: pathFromPoints("open", [[-340.000, 0.000], [-318.750, 28.288], [-297.500, 55.489], [-276.250, 80.558], [-255.000, 102.530], [-233.750, 120.563], [-212.500, 133.963], [-191.250, 142.214], [-170.000, 145.000], [-148.750, 142.214], [-127.500, 133.963], [-106.250, 120.563], [-85.000, 102.530], [-63.750, 80.558], [-42.500, 55.489], [-21.250, 28.288], [0.000, 0.000], [21.250, -28.288], [42.500, -55.489], [63.750, -80.558], [85.000, -102.530], [106.250, -120.563], [127.500, -133.963], [148.750, -142.214], [170.000, -145.000], [191.250, -142.214], [212.500, -133.963], [233.750, -120.563], [255.000, -102.530], [276.250, -80.558], [297.500, -55.489], [318.750, -28.288], [340.000, 0.000]])
    strokeColor: rgba(0.08, 0.65, 1.0, 0.18)
    strokeWidth: 28
    strokeLinecap: "round"
    fillColor: none()
  }
  w.hWaveGlow = Path {
    d: pathFromPoints("open", [[-340.000, 0.000], [-333.265, -8.896], [-325.972, -17.450], [-317.584, -25.334], [-307.609, -32.244], [-295.611, -37.915], [-281.237, -42.129], [-264.220, -44.724], [-244.400, -45.600], [-221.720, -44.724], [-196.237, -42.129], [-168.111, -37.915], [-137.609, -32.244], [-105.084, -25.334], [-70.972, -17.450], [-35.765, -8.896], [0.000, 0.000], [35.765, 8.896], [70.972, 17.450], [105.084, 25.334], [137.609, 32.244], [168.111, 37.915], [196.237, 42.129], [221.720, 44.724], [244.400, 45.600], [264.220, 44.724], [281.237, 42.129], [295.611, 37.915], [307.609, 32.244], [317.584, 25.334], [325.972, 17.450], [333.265, 8.896], [340.000, 0.000]])
    strokeColor: rgba(0.20, 0.95, 0.48, 0.15)
    strokeWidth: 28
    strokeLinecap: "round"
    fillColor: none()
  }

  w.eWave = Path {
    d: pathFromPoints("open", [[-340.000, 0.000], [-318.750, 28.288], [-297.500, 55.489], [-276.250, 80.558], [-255.000, 102.530], [-233.750, 120.563], [-212.500, 133.963], [-191.250, 142.214], [-170.000, 145.000], [-148.750, 142.214], [-127.500, 133.963], [-106.250, 120.563], [-85.000, 102.530], [-63.750, 80.558], [-42.500, 55.489], [-21.250, 28.288], [0.000, 0.000], [21.250, -28.288], [42.500, -55.489], [63.750, -80.558], [85.000, -102.530], [106.250, -120.563], [127.500, -133.963], [148.750, -142.214], [170.000, -145.000], [191.250, -142.214], [212.500, -133.963], [233.750, -120.563], [255.000, -102.530], [276.250, -80.558], [297.500, -55.489], [318.750, -28.288], [340.000, 0.000]])
    strokeColor: rgba(0.12, 0.82, 1.0, 1.0)
    strokeWidth: 13
    strokeLinecap: "round"
    fillColor: none()
  }
  w.hWave = Path {
    d: pathFromPoints("open", [[-340.000, 0.000], [-333.265, -8.896], [-325.972, -17.450], [-317.584, -25.334], [-307.609, -32.244], [-295.611, -37.915], [-281.237, -42.129], [-264.220, -44.724], [-244.400, -45.600], [-221.720, -44.724], [-196.237, -42.129], [-168.111, -37.915], [-137.609, -32.244], [-105.084, -25.334], [-70.972, -17.450], [-35.765, -8.896], [0.000, 0.000], [35.765, 8.896], [70.972, 17.450], [105.084, 25.334], [137.609, 32.244], [168.111, 37.915], [196.237, 42.129], [221.720, 44.724], [244.400, 45.600], [264.220, 44.724], [281.237, 42.129], [295.611, 37.915], [307.609, 32.244], [317.584, 25.334], [325.972, 17.450], [333.265, 8.896], [340.000, 0.000]])
    strokeColor: rgba(0.30, 0.96, 0.55, 1.0)
    strokeWidth: 13
    strokeLinecap: "round"
    fillColor: none()
  }
  w.eVec0 = Line {
    start: (-255.000, 0)
    end: (-255.000, 102.530)
    strokeColor: rgba(0.12, 0.82, 1.0, 0.22)
    strokeWidth: 3
  }
  w.hVec0 = Line {
    start: (-255.000, 0)
    end: (-307.609, -32.244)
    strokeColor: rgba(0.30, 0.96, 0.55, 0.22)
    strokeWidth: 3
  }
  w.eVec1 = Line {
    start: (-170.000, 0)
    end: (-170.000, 145.000)
    strokeColor: rgba(0.12, 0.82, 1.0, 0.22)
    strokeWidth: 3
  }
  w.hVec1 = Line {
    start: (-170.000, 0)
    end: (-244.400, -45.600)
    strokeColor: rgba(0.30, 0.96, 0.55, 0.22)
    strokeWidth: 3
  }
  w.eVec2 = Line {
    start: (-85.000, 0)
    end: (-85.000, 102.530)
    strokeColor: rgba(0.12, 0.82, 1.0, 0.22)
    strokeWidth: 3
  }
  w.hVec2 = Line {
    start: (-85.000, 0)
    end: (-137.609, -32.244)
    strokeColor: rgba(0.30, 0.96, 0.55, 0.22)
    strokeWidth: 3
  }
  w.eVec3 = Line {
    start: (85.000, 0)
    end: (85.000, -102.530)
    strokeColor: rgba(0.12, 0.82, 1.0, 0.22)
    strokeWidth: 3
  }
  w.hVec3 = Line {
    start: (85.000, 0)
    end: (137.609, 32.244)
    strokeColor: rgba(0.30, 0.96, 0.55, 0.22)
    strokeWidth: 3
  }
  w.eVec4 = Line {
    start: (170.000, 0)
    end: (170.000, -145.000)
    strokeColor: rgba(0.12, 0.82, 1.0, 0.22)
    strokeWidth: 3
  }
  w.hVec4 = Line {
    start: (170.000, 0)
    end: (244.400, 45.600)
    strokeColor: rgba(0.30, 0.96, 0.55, 0.22)
    strokeWidth: 3
  }
  w.eVec5 = Line {
    start: (255.000, 0)
    end: (255.000, -102.530)
    strokeColor: rgba(0.12, 0.82, 1.0, 0.22)
    strokeWidth: 3
  }
  w.hVec5 = Line {
    start: (255.000, 0)
    end: (307.609, 32.244)
    strokeColor: rgba(0.30, 0.96, 0.55, 0.22)
    strokeWidth: 3
  }
}
